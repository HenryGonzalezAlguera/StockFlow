@model StockFlowWEB.Models.Request.LoginRequest

@{
    ViewData["Title"] =
        "Iniciar sesión";

    Layout =
        "_LoginLayout";
}


<div class="login-wrapper">

    <div class="login-container">


        <!-- =====================================================
             BRAND
        ====================================================== -->

        <div class="login-brand">

            <div class="brand-icon">

                <i class="bi bi-box-seam"></i>

            </div>


            <h1>
                StockFlow
            </h1>


            <p>
                Inventory & Sales Management
            </p>

        </div>


        <!-- =====================================================
             CARD
        ====================================================== -->

        <div class="login-card">


            <div class="mb-4">

                <h2>
                    Bienvenido
                </h2>


                <p class="text-muted mb-0">

                    Inicia sesión para administrar tu negocio.

                </p>

            </div>


            <!-- =================================================
                 MENSAJE REGISTRO EXITOSO
            ================================================== -->
            @if (TempData["MensajeExito"] != null)
            {
                <div class="alert alert-success">

                    <i class="bi bi-check-circle me-2"></i>

                    @TempData["MensajeExito"]

                </div>
            }


            <!-- =================================================
                 MENSAJE ERROR
            ================================================== -->
            @if (ViewBag.Mensaje != null)
            {
                <div class="alert alert-danger">

                    <i class="bi bi-exclamation-circle me-2"></i>

                    @ViewBag.Mensaje

                </div>
            }


            <!-- =================================================
                 LOGIN
            ================================================== -->

            <form asp-controller="Home"
                  asp-action="Index"
                  method="post">


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- =============================================
                     EMPRESA
                ============================================== -->

                <div class="mb-3">

                    <label asp-for="IdentificacionEmpresa"
                           class="form-label">

                        Empresa

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-building"></i>

                        </span>


                        <input asp-for="IdentificacionEmpresa"
                               class="form-control"
                               autocomplete="organization"
                               placeholder="Identificación de la empresa" />

                    </div>


                    <span asp-validation-for="IdentificacionEmpresa"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =============================================
                     CORREO
                ============================================== -->

                <div class="mb-3">

                    <label asp-for="Correo"
                           class="form-label">

                        Correo electrónico

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-envelope"></i>

                        </span>


                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               autocomplete="username"
                               placeholder="correo@empresa.com" />

                    </div>


                    <span asp-validation-for="Correo"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =============================================
                     CONTRASEÑA
                ============================================== -->

                <div class="mb-4">

                    <label asp-for="Contrasena"
                           class="form-label">

                        Contraseña

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-lock"></i>

                        </span>


                        <input asp-for="Contrasena"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               placeholder="••••••••" />

                    </div>


                    <span asp-validation-for="Contrasena"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =============================================
                     LOGIN
                ============================================== -->

                <button type="submit"
                        class="btn btn-primary btn-lg w-100">

                    Iniciar sesión

                    <i class="bi bi-arrow-right ms-2"></i>

                </button>

            </form>


            <!-- =================================================
                 SEPARADOR
            ================================================== -->

            <div class="position-relative my-4">

                <hr />

                <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">

                    o

                </span>

            </div>


            <!-- =================================================
                 REGISTRO
            ================================================== -->

            <div class="text-center">

                <p class="text-muted mb-2">

                    ¿Todavía no utilizas StockFlow?

                </p>


                <a asp-controller="Home"
                   asp-action="Registrar"
                   class="btn btn-outline-primary w-100">

                    <i class="bi bi-building-add me-2"></i>

                    Crear una empresa

                </a>

            </div>


        </div>


        <div class="login-footer">

            StockFlow © @DateTime.Now.Year

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
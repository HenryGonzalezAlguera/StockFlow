@model StockFlowWEB.Models.ViewModels.RegistrarUsuarioViewModel

@{
    ViewData["Title"] = "Registrar usuario";
}


<div class="page-header">

    <div>

        <h1>
            Registrar usuario
        </h1>

        <p>
            Crea una cuenta de Empleado o Consulta para tu empresa.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información de la cuenta
        </h5>

        <p>
            El nuevo usuario podrá iniciar sesión con la identificación de esta empresa, su correo y la contraseña definida aquí.
        </p>

    </div>


    <div class="content-card-body">

        <form asp-action="Registrar"
              method="post"
              id="formRegistrarUsuario">


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">


                <div class="col-md-6">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre

                    </label>


                    <input asp-for="Nombre"
                           class="form-control"
                           autocomplete="name"
                           placeholder="Nombre completo" />


                    <span asp-validation-for="Nombre"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Correo"
                           class="form-label">

                        Correo electrónico

                    </label>


                    <input asp-for="Correo"
                           type="email"
                           class="form-control"
                           autocomplete="email"
                           placeholder="usuario@empresa.com" />


                    <span asp-validation-for="Correo"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="IdRol"
                           class="form-label">
                    </label>


                    <select asp-for="IdRol"
                            class="form-select">

                        <option value="0">
                            Seleccione un rol
                        </option>


                        @foreach (var rol in Model.Roles)
                        {
                            <option value="@rol.IdRol">
                                @rol.NombreRol
                            </option>
                        }

                    </select>


                    <span asp-validation-for="IdRol"
                          class="text-danger small">
                    </span>


                    <div class="form-text">

                        Empleado puede operar ventas, compras y maestros. Consulta tiene acceso de solo lectura.

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="alert alert-light border mb-0 h-100">

                        <div class="d-flex gap-2">

                            <i class="bi bi-shield-lock text-primary"></i>

                            <small class="text-muted">

                                El rol Administrador no se asigna desde este módulo. La cuenta principal de la empresa permanece protegida.

                            </small>

                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <label asp-for="Contrasena"
                           class="form-label">
                    </label>


                    <input asp-for="Contrasena"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Mínimo 8 caracteres" />


                    <span asp-validation-for="Contrasena"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="ConfirmarContrasena"
                           class="form-label">
                    </label>


                    <input asp-for="ConfirmarContrasena"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Repita la contraseña" />


                    <span asp-validation-for="ConfirmarContrasena"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary"
                        id="btnRegistrarUsuario">

                    <i class="bi bi-person-plus me-1"
                       id="iconoRegistrarUsuario"></i>

                    <span id="textoRegistrarUsuario">
                        Guardar usuario
                    </span>

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        const formUsuario =
            document.getElementById(
                "formRegistrarUsuario"
            );


        const btnRegistrarUsuario =
            document.getElementById(
                "btnRegistrarUsuario"
            );


        const iconoRegistrarUsuario =
            document.getElementById(
                "iconoRegistrarUsuario"
            );


        const textoRegistrarUsuario =
            document.getElementById(
                "textoRegistrarUsuario"
            );


        let envioEnCurso =
            false;


        formUsuario.addEventListener(
            "submit",
            function(event) {
                if (envioEnCurso) {
                    event.preventDefault();
                    return;
                }


                if (!formUsuario.checkValidity()) {
                    event.preventDefault();
                    formUsuario.reportValidity();
                    return;
                }


                if (
                    typeof window.jQuery !== "undefined"
                    &&
                    typeof window.jQuery.fn.valid === "function"
                    &&
                    !window.jQuery(formUsuario).valid()
                ) {
                    event.preventDefault();
                    return;
                }


                envioEnCurso =
                    true;


                btnRegistrarUsuario.disabled =
                    true;


                iconoRegistrarUsuario.className =
                    "bi bi-hourglass-split me-1";


                textoRegistrarUsuario.textContent =
                    "Guardando...";
            }
        );

    </script>
}

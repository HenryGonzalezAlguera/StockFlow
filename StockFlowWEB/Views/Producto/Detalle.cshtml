@model StockFlowWEB.Models.Response.ProductoResponse

@{
    ViewData["Title"] = "Detalle producto";

    var rol =
        Context.Session
            .GetString("Rol")
        ??
        string.Empty;

    var puedeEditar =
        rol == "Administrador"
        ||
        rol == "Empleado";
}


<div class="page-header">

    <div>

        <h1>
            @Model.Nombre
        </h1>

        <p>
            @Model.Codigo · @Model.Categoria
        </p>

    </div>


    <div class="d-flex gap-2">

        @if (puedeEditar)
        {
            <a asp-action="Modificar"
               asp-route-id="@Model.IdProducto"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>

                Editar

            </a>
        }


        <a asp-action="Index"
           class="btn btn-outline-secondary">

            Volver

        </a>

    </div>

</div>


<div class="row g-3 mb-4">


    <div class="col-md-3">

        <div class="kpi-card">

            <div class="kpi-top">

                <span class="kpi-label">
                    Stock actual
                </span>

                <div class="kpi-icon @(Model.StockBajo ? "danger" : "success")">

                    <i class="bi bi-boxes"></i>

                </div>

            </div>

            <p class="kpi-value">
                @Model.StockActual
            </p>

        </div>

    </div>


    <div class="col-md-3">

        <div class="kpi-card">

            <div class="kpi-top">

                <span class="kpi-label">
                    Stock mínimo
                </span>

                <div class="kpi-icon warning">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>

            </div>

            <p class="kpi-value">
                @Model.StockMinimo
            </p>

        </div>

    </div>


    <div class="col-md-3">

        <div class="kpi-card">

            <div class="kpi-top">

                <span class="kpi-label">
                    Precio compra
                </span>

                <div class="kpi-icon primary">

                    <i class="bi bi-bag"></i>

                </div>

            </div>

            <p class="kpi-value fs-5">
                ₡@Model.PrecioCompra.ToString("N2")
            </p>

        </div>

    </div>


    <div class="col-md-3">

        <div class="kpi-card">

            <div class="kpi-top">

                <span class="kpi-label">
                    Precio venta
                </span>

                <div class="kpi-icon success">

                    <i class="bi bi-cash-stack"></i>

                </div>

            </div>

            <p class="kpi-value fs-5">
                ₡@Model.PrecioVenta.ToString("N2")
            </p>

        </div>

    </div>


</div>


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información general
        </h5>

    </div>


    <div class="content-card-body">

        <div class="row g-4">


            <div class="col-md-6">

                <div class="small text-muted mb-1">
                    Código
                </div>

                <strong>
                    @Model.Codigo
                </strong>

            </div>


            <div class="col-md-6">

                <div class="small text-muted mb-1">
                    Categoría
                </div>

                <strong>
                    @Model.Categoria
                </strong>

            </div>


            <div class="col-md-6">

                <div class="small text-muted mb-1">
                    Estado
                </div>


                @if (Model.Estado)
                {
                    <span class="badge rounded-pill text-bg-success">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary">
                        Inactivo
                    </span>
                }

            </div>


            <div class="col-md-6">

                <div class="small text-muted mb-1">
                    Fecha de registro
                </div>

                <strong>
                    @Model.FechaRegistro.ToString("dd/MM/yyyy")
                </strong>

            </div>


            <div class="col-12">

                <div class="small text-muted mb-1">
                    Descripción
                </div>

                <p class="mb-0">

                    @(string.IsNullOrWhiteSpace(Model.Descripcion)
                        ? "Sin descripción."
                        : Model.Descripcion)

                </p>

            </div>


        </div>

    </div>

</div>
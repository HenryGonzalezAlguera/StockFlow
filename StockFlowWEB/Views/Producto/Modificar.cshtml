@model StockFlowWEB.Models.ViewModels.ProductoFormViewModel

@{
    ViewData["Title"] = "Modificar producto";
}


<div class="page-header">

    <div>

        <h1>
            Modificar producto
        </h1>

        <p>
            Actualiza la información comercial del producto.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información del producto
        </h5>

        <p>
            El stock actual no se modifica desde esta pantalla.
        </p>

    </div>


    <div class="content-card-body">

        <form asp-action="Modificar"
              method="post">


            <input asp-for="IdProducto"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">


                <div class="col-md-4">

                    <label asp-for="Codigo"
                           class="form-label">

                        Código

                    </label>

                    <input asp-for="Codigo"
                           class="form-control" />

                    <span asp-validation-for="Codigo"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-8">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre

                    </label>

                    <input asp-for="Nombre"
                           class="form-control" />

                    <span asp-validation-for="Nombre"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="IdCategoria"
                           class="form-label">

                        Categoría

                    </label>


                    <select asp-for="IdCategoria"
                            class="form-select">

                        @foreach (
                            var categoria
                            in Model.Categorias)
                        {
                            <option value="@categoria.IdCategoria">

                                @categoria.Nombre

                            </option>
                        }

                    </select>


                    <span asp-validation-for="IdCategoria"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="StockMinimo"
                           class="form-label">

                        Stock mínimo

                    </label>

                    <input asp-for="StockMinimo"
                           type="number"
                           step="0.001"
                           min="0"
                           class="form-control" />

                </div>


                <div class="col-md-6">

                    <label asp-for="PrecioCompra"
                           class="form-label">

                        Precio de compra

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₡
                        </span>

                        <input asp-for="PrecioCompra"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                    </div>

                </div>


                <div class="col-md-6">

                    <label asp-for="PrecioVenta"
                           class="form-label">

                        Precio de venta

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            ₡
                        </span>

                        <input asp-for="PrecioVenta"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                    </div>

                </div>


                <div class="col-12">

                    <label asp-for="Descripcion"
                           class="form-label">

                        Descripción

                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4">
                    </textarea>

                </div>


            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
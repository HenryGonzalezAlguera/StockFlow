@model StockFlowWEB.Models.ViewModels.ProductoIndexViewModel

@{
    ViewData["Title"] = "Productos";

    var rol =
        Context.Session.GetString("Rol")
        ?? string.Empty;


    var puedeEditar =
        rol == "Administrador"
        ||
        rol == "Empleado";


    var esAdministrador =
        rol == "Administrador";


    var primerRegistro =
        Model.TotalRegistros == 0
        ? 0
        : ((Model.PaginaActual - 1)
            * Model.CantidadPagina) + 1;


    var ultimoRegistro =
        Math.Min(
            Model.PaginaActual
            * Model.CantidadPagina,
            Model.TotalRegistros
        );


    var inicioPagina =
        Math.Max(
            1,
            Model.PaginaActual - 2
        );


    var finPagina =
        Math.Min(
            Model.TotalPaginas,
            Model.PaginaActual + 2
        );
}


<!-- =========================================================
     PAGE HEADER
========================================================= -->

<div class="page-header">

    <div>

        <h1>
            Productos
        </h1>

        <p>
            Administra el catálogo, precios y existencias de tu negocio.
        </p>

    </div>


    @if (puedeEditar)
    {
        <a asp-controller="Producto"
           asp-action="Registrar"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>

            Nuevo producto

        </a>
    }

</div>



<!-- =========================================================
     MENSAJES
========================================================= -->
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success d-flex align-items-center">

        <i class="bi bi-check-circle me-2"></i>

        <div>
            @TempData["MensajeExito"]
        </div>

    </div>
}


@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger d-flex align-items-center">

        <i class="bi bi-exclamation-circle me-2"></i>

        <div>
            @TempData["MensajeError"]
        </div>

    </div>
}


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning d-flex align-items-center">

        <i class="bi bi-exclamation-triangle me-2"></i>

        <div>
            @ViewBag.Mensaje
        </div>

    </div>
}



<!-- =========================================================
     CONTENT CARD
========================================================= -->

<div class="content-card">


    <!-- =====================================================
         FILTROS
    ====================================================== -->

    <div class="content-card-body border-bottom">

        <form method="get"
              asp-controller="Producto"
              asp-action="Index">


            <div class="row g-3 align-items-end">


                <!-- BUSQUEDA -->

                <div class="col-xl-4 col-lg-6">

                    <label class="form-label">
                        Buscar
                    </label>


                    <div class="input-group">

                        <span class="input-group-text bg-white">

                            <i class="bi bi-search"></i>

                        </span>


                        <input type="text"
                               name="busqueda"
                               value="@Model.Busqueda"
                               class="form-control"
                               autocomplete="off"
                               placeholder="Código, nombre o descripción..." />

                    </div>

                </div>



                <!-- CATEGORIA -->

                <div class="col-xl-3 col-lg-6">

                    <label class="form-label">
                        Categoría
                    </label>


                    <select name="idCategoria"
                            class="form-select">

                        <option value="">
                            Todas las categorías
                        </option>


                        @foreach (var categoria in Model.Categorias)
                        {
                            if (Model.IdCategoria ==
                                categoria.IdCategoria)
                            {
                                <option value="@categoria.IdCategoria"
                                        selected>

                                    @categoria.Nombre

                                </option>
                            }
                            else
                            {
                                <option value="@categoria.IdCategoria">

                                    @categoria.Nombre

                                </option>
                            }
                        }

                    </select>

                </div>



                <!-- ESTADO -->

                <div class="col-xl-2 col-md-4">

                    <label class="form-label">
                        Estado
                    </label>


                    <select name="estado"
                            class="form-select">

                        @if (Model.Estado == null)
                        {
                            <option value="" selected>
                                Todos
                            </option>
                        }
                        else
                        {
                            <option value="">
                                Todos
                            </option>
                        }


                        @if (Model.Estado == true)
                        {
                            <option value="true" selected>
                                Activos
                            </option>
                        }
                        else
                        {
                            <option value="true">
                                Activos
                            </option>
                        }


                        @if (Model.Estado == false)
                        {
                            <option value="false" selected>
                                Inactivos
                            </option>
                        }
                        else
                        {
                            <option value="false">
                                Inactivos
                            </option>
                        }

                    </select>

                </div>



                <!-- CANTIDAD PAGINA -->

                <div class="col-xl-1 col-md-3">

                    <label class="form-label">
                        Mostrar
                    </label>


                    <select name="cantidadPagina"
                            class="form-select">

                        @if (Model.CantidadPagina == 10)
                        {
                            <option value="10" selected>
                                10
                            </option>
                        }
                        else
                        {
                            <option value="10">
                                10
                            </option>
                        }


                        @if (Model.CantidadPagina == 20)
                        {
                            <option value="20" selected>
                                20
                            </option>
                        }
                        else
                        {
                            <option value="20">
                                20
                            </option>
                        }


                        @if (Model.CantidadPagina == 50)
                        {
                            <option value="50" selected>
                                50
                            </option>
                        }
                        else
                        {
                            <option value="50">
                                50
                            </option>
                        }

                    </select>

                </div>



                <!-- BOTONES -->

                <div class="col-xl-2 col-md-5">

                    <div class="d-flex gap-2">


                        <button type="submit"
                                class="btn btn-primary flex-grow-1">

                            <i class="bi bi-funnel me-1"></i>

                            Filtrar

                        </button>


                        <a asp-controller="Producto"
                           asp-action="Index"
                           class="btn btn-outline-secondary"
                           title="Limpiar filtros">

                            <i class="bi bi-x-lg"></i>

                        </a>

                    </div>

                </div>


            </div>

        </form>

    </div>



    <!-- =====================================================
         RESUMEN SUPERIOR
    ====================================================== -->

    <div class="px-3 py-3 border-bottom d-flex
        flex-column flex-sm-row
        justify-content-between
        align-items-sm-center
        gap-2">

        <div>

            <strong>
                @Model.TotalRegistros
            </strong>

            <span class="text-muted">
                producto@(Model.TotalRegistros == 1 ? "" : "s") encontrado@(Model.TotalRegistros == 1 ? "" : "s")
            </span>

        </div>


        @if (Model.TotalRegistros > 0)
        {
            <div class="small text-muted">

                Página

                <strong>
                    @Model.PaginaActual
                </strong>

                de

                <strong>
                    @Model.TotalPaginas
                </strong>

            </div>
        }

    </div>



    <!-- =====================================================
         TABLA
    ====================================================== -->
    @if (Model.Productos.Any())
    {

        <div class="table-responsive">

            <table class="table table-modern align-middle">

                <thead>

                    <tr>

                        <th>
                            Producto
                        </th>

                        <th>
                            Categoría
                        </th>

                        <th>
                            Precio
                        </th>

                        <th>
                            Stock
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var producto in Model.Productos)
                    {

                        <tr>


                            <!-- =====================================
                                 PRODUCTO
                            ====================================== -->

                            <td>

                                <div class="d-flex align-items-center gap-3">


                                    <div class="product-table-icon">

                                        <i class="bi bi-box"></i>

                                    </div>


                                    <div>

                                        <strong class="d-block">

                                            @producto.Nombre

                                        </strong>


                                        <span class="small text-muted">

                                            @producto.Codigo

                                        </span>

                                    </div>

                                </div>

                            </td>



                            <!-- =====================================
                                 CATEGORIA
                            ====================================== -->

                            <td>

                                <span class="text-body">

                                    @producto.Categoria

                                </span>

                            </td>



                            <!-- =====================================
                                 PRECIOS
                            ====================================== -->

                            <td>

                                <strong class="d-block">

                                    ₡@producto.PrecioVenta.ToString("N2")

                                </strong>


                                <span class="small text-muted">

                                    Costo:
                                    ₡@producto.PrecioCompra.ToString("N2")

                                </span>

                            </td>



                            <!-- =====================================
                                 STOCK
                            ====================================== -->

                            <td>

                                @if (producto.StockBajo)
                                {

                                    <span class="badge-stock">

                                        <i class="bi bi-exclamation-triangle me-1"></i>

                                        @producto.StockActual.ToString("N3")

                                    </span>

                                }
                                else
                                {

                                    <strong class="d-block">

                                        @producto.StockActual.ToString("N3")

                                    </strong>

                                }


                                <span class="small text-muted d-block mt-1">

                                    Mínimo:
                                    @producto.StockMinimo.ToString("N3")

                                </span>

                            </td>



                            <!-- =====================================
                                 ESTADO
                            ====================================== -->

                            <td>

                                @if (producto.Estado)
                                {

                                    <span class="badge rounded-pill text-bg-success">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Activo

                                    </span>

                                }
                                else
                                {

                                    <span class="badge rounded-pill text-bg-secondary">

                                        <i class="bi bi-pause-circle me-1"></i>

                                        Inactivo

                                    </span>

                                }

                            </td>



                            <!-- =====================================
                                 ACCIONES
                            ====================================== -->

                            <td class="text-end">

                                <div class="dropdown">


                                    <button class="btn btn-sm btn-light"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">

                                        <i class="bi bi-three-dots"></i>

                                    </button>


                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">


                                        <!-- VER DETALLE -->

                                        <li>

                                            <a class="dropdown-item"
                                               asp-controller="Producto"
                                               asp-action="Detalle"
                                               asp-route-id="@producto.IdProducto">

                                                <i class="bi bi-eye me-2"></i>

                                                Ver detalle

                                            </a>

                                        </li>



                                        <!-- EDITAR -->
                                        @if (puedeEditar)
                                        {

                                            <li>

                                                <a class="dropdown-item"
                                                   asp-controller="Producto"
                                                   asp-action="Modificar"
                                                   asp-route-id="@producto.IdProducto">

                                                    <i class="bi bi-pencil me-2"></i>

                                                    Editar

                                                </a>

                                            </li>

                                        }



                                        <!-- CAMBIAR ESTADO -->
                                        @if (esAdministrador)
                                        {

                                            <li>

                                                <hr class="dropdown-divider" />

                                            </li>


                                            <li>

                                                <form asp-controller="Producto"
                                                      asp-action="CambiarEstado"
                                                      asp-route-id="@producto.IdProducto"
                                                      method="post"
                                                      class="m-0">


                                                    @Html.AntiForgeryToken()


                                                    <button type="submit"
                                                            class="dropdown-item @(producto.Estado ? "text-danger" : "text-success")"
                                                            onclick="return confirm('@(
                                                            producto.Estado
                                                                ? "¿Desea desactivar este producto?"
                                                                : "¿Desea activar este producto?"
                                                                                                                )');">


                                                        @if (producto.Estado)
                                                        {

                                                            <i class="bi bi-pause-circle me-2"></i>

                                                            <span>
                                                                Desactivar
                                                            </span>

                                                        }
                                                        else
                                                        {

                                                            <i class="bi bi-check-circle me-2"></i>

                                                            <span>
                                                                Activar
                                                            </span>

                                                        }

                                                    </button>

                                                </form>

                                            </li>

                                        }


                                    </ul>

                                </div>

                            </td>


                        </tr>

                    }

                </tbody>

            </table>

        </div>

    }
    else
    {

        <!-- =================================================
             EMPTY STATE
        ================================================== -->

        <div class="empty-state">

            <i class="bi bi-box-seam"></i>


            <strong class="d-block mb-1">

                No encontramos productos

            </strong>


            <span class="d-block mb-3">

                No existen registros que coincidan con los filtros seleccionados.

            </span>


            @if (puedeEditar)
            {

                <a asp-controller="Producto"
                   asp-action="Registrar"
                   class="btn btn-primary btn-sm">

                    <i class="bi bi-plus-lg me-1"></i>

                    Registrar producto

                </a>

            }

        </div>

    }



    <!-- =====================================================
         PAGINACION
    ====================================================== -->
    @if (Model.TotalRegistros > 0)
    {

        <div class="d-flex
            flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-3
            px-3
            py-3
            border-top">


            <!-- INFORMACION -->

            <div class="small text-muted">

                Mostrando

                <strong>
                    @primerRegistro
                </strong>

                -

                <strong>
                    @ultimoRegistro
                </strong>

                de

                <strong>
                    @Model.TotalRegistros
                </strong>

                productos

            </div>



            <!-- PAGINADOR -->
            @if (Model.TotalPaginas > 1)
            {

                <nav aria-label="Paginación de productos">

                    <ul class="pagination pagination-sm mb-0">


                        <!-- PRIMERA PAGINA -->

                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-controller="Producto"
                               asp-action="Index"
                               asp-route-pagina="1"
                               asp-route-cantidadPagina="@Model.CantidadPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-idCategoria="@Model.IdCategoria"
                               asp-route-estado="@Model.Estado"
                               title="Primera página">

                                <i class="bi bi-chevron-double-left"></i>

                            </a>

                        </li>



                        <!-- ANTERIOR -->

                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-controller="Producto"
                               asp-action="Index"
                               asp-route-pagina="@(Model.PaginaActual - 1)"
                               asp-route-cantidadPagina="@Model.CantidadPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-idCategoria="@Model.IdCategoria"
                               asp-route-estado="@Model.Estado"
                               title="Página anterior">

                                <i class="bi bi-chevron-left"></i>

                            </a>

                        </li>



                        <!-- PAGINAS -->
                        @for (var pagina = inicioPagina;
                                                      pagina <= finPagina;
                                                      pagina++)
                        {

                            <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")">

                                <a class="page-link"
                                   asp-controller="Producto"
                                   asp-action="Index"
                                   asp-route-pagina="@pagina"
                                   asp-route-cantidadPagina="@Model.CantidadPagina"
                                   asp-route-busqueda="@Model.Busqueda"
                                   asp-route-idCategoria="@Model.IdCategoria"
                                   asp-route-estado="@Model.Estado">

                                    @pagina

                                </a>

                            </li>

                        }



                        <!-- SIGUIENTE -->

                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">

                            <a class="page-link"
                               asp-controller="Producto"
                               asp-action="Index"
                               asp-route-pagina="@(Model.PaginaActual + 1)"
                               asp-route-cantidadPagina="@Model.CantidadPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-idCategoria="@Model.IdCategoria"
                               asp-route-estado="@Model.Estado"
                               title="Página siguiente">

                                <i class="bi bi-chevron-right"></i>

                            </a>

                        </li>



                        <!-- ULTIMA PAGINA -->

                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">

                            <a class="page-link"
                               asp-controller="Producto"
                               asp-action="Index"
                               asp-route-pagina="@Model.TotalPaginas"
                               asp-route-cantidadPagina="@Model.CantidadPagina"
                               asp-route-busqueda="@Model.Busqueda"
                               asp-route-idCategoria="@Model.IdCategoria"
                               asp-route-estado="@Model.Estado"
                               title="Última página">

                                <i class="bi bi-chevron-double-right"></i>

                            </a>

                        </li>


                    </ul>

                </nav>

            }


        </div>

    }


</div>
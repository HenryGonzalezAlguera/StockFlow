@model StockFlowWEB.Models.ViewModels.ProductoFormViewModel

@{
    ViewData["Title"] =
        "Nuevo producto";
}


<div class="page-header">

    <div>

        <h1>
            Nuevo producto
        </h1>

        <p>
            Agrega un nuevo producto al catálogo.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información del producto
        </h5>

        <p>
            Completa los datos principales del producto.
        </p>

    </div>


    <div class="content-card-body">

        <form asp-action="Registrar"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">


                <!-- =========================================
                     CÓDIGO AUTOMÁTICO
                     ========================================= -->

                <div class="col-md-4">

                    <label class="form-label">

                        Código

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="bi bi-upc-scan"></i>

                        </span>


                        <input type="text"
                               class="form-control"
                               value="Se genera automáticamente"
                               readonly />

                    </div>


                    <div class="form-text">

                        StockFlow asignará el siguiente
                        código disponible al guardar.

                    </div>

                </div>


                <!-- =========================================
                     NOMBRE
                     ========================================= -->

                <div class="col-md-8">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre del producto

                    </label>


                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ej. Teclado Logitech K120" />


                    <span asp-validation-for="Nombre"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =========================================
                     CATEGORÍA
                     ========================================= -->

                <div class="col-md-6">

                    <label asp-for="IdCategoria"
                           class="form-label">

                        Categoría

                    </label>


                    <select asp-for="IdCategoria"
                            class="form-select">

                        <option value="0">
                            Seleccione una categoría
                        </option>


                        @foreach (
                            var categoria
                            in Model.Categorias)
                        {
                            <option value="@categoria.IdCategoria">

                                @categoria.Nombre

                            </option>
                        }

                    </select>


                    <span asp-validation-for="IdCategoria"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =========================================
                     STOCK MÍNIMO
                     ========================================= -->

                <div class="col-md-6">

                    <label asp-for="StockMinimo"
                           class="form-label">

                        Stock mínimo

                    </label>


                    <input asp-for="StockMinimo"
                           asp-format="{0:0}"
                           type="number"
                           step="1"
                           min="0"
                           class="form-control" />


                    <span asp-validation-for="StockMinimo"
                          class="text-danger small">
                    </span>


                    <div class="form-text">

                        StockFlow alertará cuando las existencias
                        lleguen a este nivel.

                    </div>

                </div>


                <!-- =========================================
                     PRECIO COMPRA
                     ========================================= -->

                <div class="col-md-6">

                    <label asp-for="PrecioCompra"
                           class="form-label">

                        Precio de compra

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">
                            ₡
                        </span>


                        <input asp-for="PrecioCompra"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                    </div>


                    <span asp-validation-for="PrecioCompra"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =========================================
                     PRECIO VENTA
                     ========================================= -->

                <div class="col-md-6">

                    <label asp-for="PrecioVenta"
                           class="form-label">

                        Precio de venta

                    </label>


                    <div class="input-group">

                        <span class="input-group-text">
                            ₡
                        </span>


                        <input asp-for="PrecioVenta"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                    </div>


                    <span asp-validation-for="PrecioVenta"
                          class="text-danger small">
                    </span>

                </div>


                <!-- =========================================
                     DESCRIPCIÓN
                     ========================================= -->

                <div class="col-12">

                    <label asp-for="Descripcion"
                           class="form-label">

                        Descripción

                    </label>


                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4"
                              placeholder="Descripción opcional del producto...">
                    </textarea>


                    <span asp-validation-for="Descripcion"
                          class="text-danger small">
                    </span>

                </div>


            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Guardar producto

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
@model StockFlowWEB.Models.ViewModels.AjusteInventarioViewModel

@{
    ViewData["Title"] = "Ajustar inventario";
}


<div class="page-header">

    <div>

        <h1>
            Ajustar inventario
        </h1>

        <p>
            Registra una corrección manual manteniendo trazabilidad.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


<div class="alert alert-warning">

    <i class="bi bi-exclamation-triangle me-2"></i>

    Los ajustes cambian directamente las existencias y quedarán
    registrados permanentemente en el historial.

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información del ajuste
        </h5>

        <p>
            El motivo es obligatorio para mantener la auditoría.
        </p>

    </div>


    <div class="content-card-body">

        <form asp-action="Ajustar"
              method="post">


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">


                <div class="col-md-6">

                    <label asp-for="IdProducto"
                           class="form-label">

                        Producto

                    </label>


                    <select asp-for="IdProducto"
                            class="form-select"
                            id="producto">

                        <option value="0">
                            Seleccione un producto
                        </option>


                        @foreach (var producto in Model.Productos)
                        {
                            <option value="@producto.IdProducto"
                                    data-stock="@producto.StockActual">

                                @producto.Codigo -
                                @producto.Nombre
                                (Stock: @producto.StockActual)

                            </option>
                        }

                    </select>


                    <span asp-validation-for="IdProducto"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="TipoAjuste"
                           class="form-label">

                        Tipo de ajuste

                    </label>


                    <select asp-for="TipoAjuste"
                            class="form-select">

                        <option value="">
                            Seleccione
                        </option>

                        <option value="ENTRADA">
                            Ajuste de entrada
                        </option>

                        <option value="SALIDA">
                            Ajuste de salida
                        </option>

                    </select>


                    <span asp-validation-for="TipoAjuste"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Cantidad"
                           class="form-label">

                        Cantidad

                    </label>


                    <input asp-for="Cantidad"
                           type="number"
                           min="0.001"
                           step="0.001"
                           class="form-control" />


                    <span asp-validation-for="Cantidad"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        Stock actual
                    </label>


                    <div class="form-control bg-light"
                         id="stockActual">

                        Seleccione un producto

                    </div>

                </div>


                <div class="col-12">

                    <label asp-for="Motivo"
                           class="form-label">

                        Motivo

                    </label>


                    <textarea asp-for="Motivo"
                              class="form-control"
                              rows="4"
                              placeholder="Ej. Productos dañados durante almacenamiento...">
                    </textarea>


                    <span asp-validation-for="Motivo"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary"
                        onclick="return confirm('¿Confirma que desea realizar este ajuste de inventario?');">

                    <i class="bi bi-check-lg me-1"></i>

                    Realizar ajuste

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        const producto =
            document.getElementById(
                "producto"
            );


        const stockActual =
            document.getElementById(
                "stockActual"
            );


        producto.addEventListener(
            "change",
            function() {

                const opcion =
                    this.options[
                    this.selectedIndex
                    ];


                const stock =
                    opcion.getAttribute(
                        "data-stock"
                    );


                if (stock === null) {

                    stockActual.textContent =
                        "Seleccione un producto";

                    return;
                }


                stockActual.textContent =
                    stock;

            }
        );

    </script>
}
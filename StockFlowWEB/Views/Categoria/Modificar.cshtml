@model StockFlowWEB.Models.ViewModels.CategoriaFormViewModel

@{
    ViewData["Title"] = "Modificar categoría";
}


<div class="page-header">

    <div>

        <h1>
            Modificar categoría
        </h1>

        <p>
            Actualiza la información de la categoría.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información de la categoría
        </h5>

    </div>


    <div class="content-card-body">

        <form asp-action="Modificar"
              method="post">


            <input asp-for="IdCategoria"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">


                <div class="col-md-6">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre

                    </label>


                    <input asp-for="Nombre"
                           class="form-control" />


                    <span asp-validation-for="Nombre"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-12">

                    <label asp-for="Descripcion"
                           class="form-label">

                        Descripción

                    </label>


                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4">
                    </textarea>


                    <span asp-validation-for="Descripcion"
                          class="text-danger small">
                    </span>

                </div>


            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
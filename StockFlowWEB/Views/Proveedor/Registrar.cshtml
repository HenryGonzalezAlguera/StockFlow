@model StockFlowWEB.Models.ViewModels.ProveedorFormViewModel

@{
    ViewData["Title"] = "Nuevo proveedor";
}


<div class="page-header">

    <div>

        <h1>
            Nuevo proveedor
        </h1>

        <p>
            Registra un proveedor para tus operaciones de compra.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="content-card">

    <div class="content-card-header">

        <h5>
            Información del proveedor
        </h5>

    </div>


    <div class="content-card-body">

        <form asp-action="Registrar"
              method="post">


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-4">


                <div class="col-md-4">

                    <label asp-for="Identificacion"
                           class="form-label">

                        Identificación

                    </label>


                    <input asp-for="Identificacion"
                           class="form-control"
                           placeholder="Ej. 3-101-123456" />

                </div>


                <div class="col-md-8">

                    <label asp-for="Nombre"
                           class="form-label">

                        Nombre

                    </label>


                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Nombre del proveedor" />


                    <span asp-validation-for="Nombre"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Correo"
                           class="form-label">

                        Correo electrónico

                    </label>


                    <input asp-for="Correo"
                           class="form-control"
                           placeholder="ventas@proveedor.com" />


                    <span asp-validation-for="Correo"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Telefono"
                           class="form-label">

                        Teléfono

                    </label>


                    <input asp-for="Telefono"
                           class="form-control"
                           placeholder="2200-0000" />

                </div>


                <div class="col-12">

                    <label asp-for="Direccion"
                           class="form-label">

                        Dirección

                    </label>


                    <textarea asp-for="Direccion"
                              class="form-control"
                              rows="3"
                              placeholder="Dirección del proveedor...">
                    </textarea>

                </div>


            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Guardar proveedor

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
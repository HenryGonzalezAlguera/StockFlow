@model StockFlowWEB.Models.ViewModels.CambiarContrasenaViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}


<div class="page-header">

    <div>

        <h1>
            Cambiar contraseña
        </h1>

        <p>
            Actualiza la contraseña utilizada para ingresar a StockFlow.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div class="row justify-content-center">

    <div class="col-xl-7 col-lg-8">

        <div class="content-card">

            <div class="content-card-header">

                <h5>
                    Seguridad
                </h5>

            </div>


            <div class="content-card-body">

                <form asp-action="CambiarContrasena"
                      method="post"
                      id="formCambiarContrasena">


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- =================================================
                         CONTRASEÑA ACTUAL
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="ContrasenaActual"
                               class="form-label">
                        </label>


                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-lock"></i>

                            </span>


                            <input asp-for="ContrasenaActual"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Contraseña actual" />

                        </div>


                        <span asp-validation-for="ContrasenaActual"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         NUEVA CONTRASEÑA
                    ================================================== -->

                    <div class="mb-3">

                        <label asp-for="ContrasenaNueva"
                               class="form-label">
                        </label>


                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-key"></i>

                            </span>


                            <input asp-for="ContrasenaNueva"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Mínimo 8 caracteres" />

                        </div>


                        <span asp-validation-for="ContrasenaNueva"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- =================================================
                         CONFIRMAR
                    ================================================== -->

                    <div class="mb-4">

                        <label asp-for="ConfirmarContrasena"
                               class="form-label">
                        </label>


                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-key-fill"></i>

                            </span>


                            <input asp-for="ConfirmarContrasena"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Repita la nueva contraseña" />

                        </div>


                        <span asp-validation-for="ConfirmarContrasena"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="alert alert-light border">

                        <div class="d-flex gap-2">

                            <i class="bi bi-info-circle text-primary"></i>

                            <small class="text-muted">
                                Después de cambiar la contraseña, StockFlow cerrará esta sesión y deberás iniciar sesión nuevamente con la nueva contraseña.
                            </small>

                        </div>

                    </div>


                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-action="Index"
                           class="btn btn-light">

                            Cancelar

                        </a>


                        <button type="submit"
                                class="btn btn-primary"
                                id="btnCambiarContrasena">

                            <i class="bi bi-shield-check me-1"
                               id="iconoCambiarContrasena"></i>

                            <span id="textoCambiarContrasena">
                                Cambiar contraseña
                            </span>

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        const form =
            document.getElementById(
                "formCambiarContrasena"
            );


        const boton =
            document.getElementById(
                "btnCambiarContrasena"
            );


        const icono =
            document.getElementById(
                "iconoCambiarContrasena"
            );


        const texto =
            document.getElementById(
                "textoCambiarContrasena"
            );


        let envioEnCurso =
            false;


        form.addEventListener(
            "submit",
            function(event) {
                if (envioEnCurso) {
                    event.preventDefault();
                    return;
                }


                if (!form.checkValidity()) {
                    event.preventDefault();
                    form.reportValidity();
                    return;
                }


                if (
                    typeof window.jQuery !== "undefined"
                    &&
                    typeof window.jQuery.fn.valid === "function"
                    &&
                    !window.jQuery(form).valid()
                ) {
                    event.preventDefault();
                    return;
                }


                envioEnCurso =
                    true;


                boton.disabled =
                    true;


                icono.className =
                    "bi bi-hourglass-split me-1";


                texto.textContent =
                    "Actualizando...";
            }
        );

    </script>
}

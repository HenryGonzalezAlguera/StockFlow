@{
    var nombre =
        Context.Session.GetString("Nombre")
        ?? "Usuario";

    var empresa =
        Context.Session.GetString("NombreEmpresa")
        ?? "StockFlow";

    var rol =
        Context.Session.GetString("Rol")
        ?? string.Empty;

    var controller =
        ViewContext.RouteData.Values["controller"]?
            .ToString()
        ?? string.Empty;


    // =========================================================
    // DATOS SEGUROS PARA LA INTERFAZ
    // =========================================================

    var inicial =
        !string.IsNullOrWhiteSpace(nombre)
        ? nombre.Substring(0, 1).ToUpper()
        : "U";


    var esAdministrador =
        rol == "Administrador";

    var esEmpleado =
        rol == "Empleado";

    var esConsulta =
        rol == "Consulta";

    var puedeOperar =
        esAdministrador ||
        esEmpleado;
}


<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        @ViewData["Title"] - StockFlow
    </title>


    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         STOCKFLOW
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body class="app-body">


    <div class="app-wrapper">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- =================================================
                 BRAND
            ================================================== -->

            <div class="sidebar-brand">


                <div class="sidebar-logo">

                    <i class="bi bi-box-seam"></i>

                </div>


                <div>

                    <span class="brand-name">
                        StockFlow
                    </span>

                    <small>
                        Business Management
                    </small>

                </div>


            </div>



            <!-- =================================================
                 NAVEGACIÓN
            ================================================== -->

            <nav class="sidebar-nav">


                <!-- =================================================
                     DASHBOARD
                ================================================== -->

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>



                <!-- =================================================
                     OPERACIONES
                ================================================== -->

                <div class="sidebar-section">
                    OPERACIONES
                </div>


                <a asp-controller="Venta"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Venta" ? "active" : "")">

                    <i class="bi bi-cart-check"></i>

                    <span>
                        Ventas
                    </span>

                </a>


                <a asp-controller="Compra"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Compra" ? "active" : "")">

                    <i class="bi bi-bag-plus"></i>

                    <span>
                        Compras
                    </span>

                </a>



                <!-- =================================================
                     INVENTARIO
                ================================================== -->

                <div class="sidebar-section">
                    INVENTARIO
                </div>


                <a asp-controller="Producto"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Producto" ? "active" : "")">

                    <i class="bi bi-box"></i>

                    <span>
                        Productos
                    </span>

                </a>


                <a asp-controller="Categoria"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Categoria" ? "active" : "")">

                    <i class="bi bi-tags"></i>

                    <span>
                        Categorías
                    </span>

                </a>


                <a asp-controller="Inventario"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Inventario" ? "active" : "")">

                    <i class="bi bi-arrow-left-right"></i>

                    <span>
                        Movimientos
                    </span>

                </a>



                <!-- =================================================
                     CONTACTOS
                ================================================== -->

                <div class="sidebar-section">
                    CONTACTOS
                </div>


                <a asp-controller="Cliente"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Cliente" ? "active" : "")">

                    <i class="bi bi-people"></i>

                    <span>
                        Clientes
                    </span>

                </a>


                <a asp-controller="Proveedor"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Proveedor" ? "active" : "")">

                    <i class="bi bi-truck"></i>

                    <span>
                        Proveedores
                    </span>

                </a>



                <!-- =================================================
                     ANÁLISIS
                ================================================== -->

                <div class="sidebar-section">
                    ANÁLISIS
                </div>


                <a asp-controller="Reporte"
                   asp-action="Index"
                   class="sidebar-link @(controller == "Reporte" ? "active" : "")">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        Reportes
                    </span>

                </a>


                @if (esAdministrador)
                {
                    <!-- =================================================
                         ADMINISTRACIÓN
                    ================================================== -->

                    <div class="sidebar-section">
                        ADMINISTRACIÓN
                    </div>


                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="sidebar-link @(controller == "Usuario" ? "active" : "")">

                        <i class="bi bi-person-gear"></i>

                        <span>
                            Usuarios
                        </span>

                    </a>
                }



            </nav>



            <!-- =================================================
                 USUARIO SIDEBAR
            ================================================== -->

            <div class="sidebar-footer">


                <div class="sidebar-user">


                    <div class="user-avatar">

                        @inicial

                    </div>


                    <div class="sidebar-user-info">

                        <strong>
                            @nombre
                        </strong>

                        <small>
                            @rol
                        </small>

                    </div>


                </div>


            </div>


        </aside>



        <!-- =====================================================
             OVERLAY MOBILE
        ====================================================== -->

        <div class="sidebar-overlay"
             id="sidebarOverlay">
        </div>



        <!-- =====================================================
             MAIN
        ====================================================== -->

        <main class="main-content">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <header class="topbar">


                <!-- BOTÓN MOBILE -->

                <div>

                    <button class="mobile-menu-button"
                            type="button"
                            id="sidebarToggle"
                            aria-label="Abrir menú">

                        <i class="bi bi-list"></i>

                    </button>

                </div>



                <!-- =================================================
                     TOPBAR DERECHA
                ================================================== -->

                <div class="topbar-right">


                    <!-- EMPRESA -->

                    <div class="company-info">

                        <i class="bi bi-building"></i>

                        <span>
                            @empresa
                        </span>

                    </div>



                    <!-- =================================================
                         MENÚ USUARIO
                    ================================================== -->

                    <div class="dropdown">


                        <button class="user-menu"
                                data-bs-toggle="dropdown"
                                type="button"
                                aria-expanded="false">


                            <div class="topbar-avatar">

                                @inicial

                            </div>


                            <div class="user-menu-text">

                                <strong>
                                    @nombre
                                </strong>

                                <small>
                                    @rol
                                </small>

                            </div>


                            <i class="bi bi-chevron-down"></i>


                        </button>



                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">


                            <!-- EMPRESA -->

                            <li>

                                <div class="px-3 py-2">

                                    <div class="small text-muted">
                                        Empresa
                                    </div>

                                    <strong class="small">
                                        @empresa
                                    </strong>

                                </div>

                            </li>


                            <!-- =================================================
                                 MI CUENTA
                            ================================================== -->

                            <li>

                                <a asp-controller="Cuenta"
                                   asp-action="Index"
                                   class="dropdown-item">

                                    <i class="bi bi-person-circle me-2"></i>

                                    Mi cuenta

                                </a>

                            </li>


                            <li>

                                <hr class="dropdown-divider" />

                            </li>



                            <!-- =================================================
                                 CERRAR SESIÓN
                            ================================================== -->

                            <li>

                                <form asp-controller="Home"
                                      asp-action="CerrarSesion"
                                      method="post"
                                      class="m-0">

                                    <button type="submit"
                                            class="dropdown-item text-danger">

                                        <i class="bi bi-box-arrow-right me-2"></i>

                                        Cerrar sesión

                                    </button>

                                </form>

                            </li>


                        </ul>


                    </div>


                </div>


            </header>



            <!-- =================================================
                 CONTENIDO DE LA PÁGINA
            ================================================== -->

            <div class="page-content">

                @RenderBody()

            </div>


        </main>


    </div>



    <!-- =========================================================
         SCRIPTS
    ========================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>



    <!-- =========================================================
         SIDEBAR RESPONSIVE
    ========================================================== -->

    <script>

            const sidebarToggle =
                document.getElementById(
                    "sidebarToggle"
                );


            const sidebarOverlay =
                document.getElementById(
                    "sidebarOverlay"
                );


            // =====================================================
            // CERRAR SIDEBAR
            // =====================================================

            function cerrarSidebar() {

                document.body
                    .classList
                    .remove(
                        "sidebar-open"
                    );

            }


            // =====================================================
            // ABRIR / CERRAR CON BOTÓN
            // =====================================================

            if (sidebarToggle) {

                sidebarToggle.addEventListener(
                    "click",
                    function() {

                        document.body
                            .classList
                            .toggle(
                                "sidebar-open"
                            );

                    }
                );

            }


            // =====================================================
            // CERRAR AL TOCAR EL OVERLAY
            // =====================================================

            if (sidebarOverlay) {

                sidebarOverlay.addEventListener(
                    "click",
                    cerrarSidebar
                );

            }


            // =====================================================
            // CERRAR DESPUÉS DE SELECCIONAR OPCIÓN EN MOBILE
            // =====================================================

            const sidebarLinks =
                document.querySelectorAll(
                    ".sidebar-link"
                );


            sidebarLinks.forEach(
                function(link) {

                    link.addEventListener(
                        "click",
                        function() {

                            if (
                                window.innerWidth <= 991
                            ) {

                                cerrarSidebar();

                            }

                        }
                    );

                }
            );


            // =====================================================
            // SI PASAMOS DE MOBILE A DESKTOP
            // LIMPIAR EL ESTADO DEL SIDEBAR
            // =====================================================

            window.addEventListener(
                "resize",
                function() {

                    if (
                        window.innerWidth > 991
                    ) {

                        cerrarSidebar();

                    }

                }
            );

    </script>



    <!-- =========================================================
         SCRIPTS DE CADA VIEW
    ========================================================== -->
    @await RenderSectionAsync(
            "Scripts",
            required: false
        )


</body>

</html>

@model StockFlowWEB.Models.ErrorViewModel

@{
    Layout = null;

    ViewData["Title"] =
        Model.Titulo;


    var icono =
        Model.StatusCode switch
        {
            404 => "bi-search",
            403 => "bi-shield-lock",
            401 => "bi-person-lock",
            400 => "bi-exclamation-circle",
            _ => "bi-exclamation-triangle"
        };
}


<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />


    <title>
        @Model.Titulo - StockFlow
    </title>


    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         STOCKFLOW
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body class="login-body">


    <div class="login-wrapper">


        <div class="login-container">


            <!-- =================================================
                 BRAND
            ================================================== -->

            <div class="login-brand">


                <div class="brand-icon">

                    <i class="bi bi-box-seam"></i>

                </div>


                <h1>
                    StockFlow
                </h1>


                <p>
                    Business Management
                </p>


            </div>



            <!-- =================================================
                 ERROR
            ================================================== -->

            <div class="login-card text-center">


                <div class="mb-4">


                    <div class="display-1 fw-bold text-primary mb-2">

                        @Model.StatusCode

                    </div>


                    <div class="fs-1 text-secondary">

                        <i class="bi @icono"></i>

                    </div>


                </div>



                <h2 class="mb-3">

                    @Model.Titulo

                </h2>


                <p class="text-muted mb-4">

                    @Model.Mensaje

                </p>



                <!-- =================================================
                     VOLVER
                ================================================== -->

                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-primary w-100 py-2">

                    <i class="bi bi-arrow-left me-2"></i>

                    Volver a StockFlow

                </a>



                <!-- =================================================
                     REQUEST ID
                ================================================== -->
                @if (Model.ShowRequestId)
                {
                    <div class="mt-4 pt-3 border-top">

                        <small class="text-muted d-block mb-1">

                            Código de referencia

                        </small>


                        <code class="small">

                            @Model.RequestId

                        </code>

                    </div>
                }


            </div>



            <div class="login-footer">

                StockFlow · Gestión empresarial

            </div>


        </div>


    </div>


</body>

</html>
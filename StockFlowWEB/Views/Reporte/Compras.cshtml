@model StockFlowWEB.Models.ViewModels.ReporteComprasViewModel

@{
    ViewData["Title"] = "Reporte de compras";

    var totalComprado =
        Model.Compras.Sum(x => x.Total);

    var totalImpuestos =
        Model.Compras.Sum(x => x.Impuesto);
}


<div class="page-header">

    <div>

        <h1>
            Reporte de compras
        </h1>

        <p>
            Analiza las compras realizadas por período.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Reportes

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning">

        @ViewBag.Mensaje

    </div>
}


<div class="content-card mb-4">

    <div class="content-card-body">

        <form method="get"
              asp-action="Compras">

            <div class="row g-3 align-items-end">


                <div class="col-md-4">

                    <label class="form-label">
                        Desde
                    </label>

                    <input type="date"
                           name="fechaDesde"
                           value="@Model.FechaDesde.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Hasta
                    </label>

                    <input type="date"
                           name="fechaHasta"
                           value="@Model.FechaHasta.ToString("yyyy-MM-dd")"
                           class="form-control" />

                </div>


                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-funnel me-1"></i>

                        Generar reporte

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


<div class="row g-3 mb-4">


    <div class="col-md-4">

        <div class="kpi-card">

            <span class="kpi-label">
                Compras realizadas
            </span>

            <p class="kpi-value">
                @Model.Compras.Count
            </p>

        </div>

    </div>


    <div class="col-md-4">

        <div class="kpi-card">

            <span class="kpi-label">
                Total comprado
            </span>

            <p class="kpi-value fs-5">
                ₡@totalComprado.ToString("N2")
            </p>

        </div>

    </div>


    <div class="col-md-4">

        <div class="kpi-card">

            <span class="kpi-label">
                Impuestos
            </span>

            <p class="kpi-value fs-5">
                ₡@totalImpuestos.ToString("N2")
            </p>

        </div>

    </div>


</div>


<div class="content-card">

    @if (Model.Compras.Any())
    {
        <div class="table-responsive">

            <table class="table table-modern align-middle">

                <thead>

                    <tr>

                        <th>Compra</th>
                        <th>Fecha</th>
                        <th>Proveedor</th>
                        <th>Usuario</th>
                        <th>Subtotal</th>
                        <th>Impuesto</th>
                        <th>Total</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var compra in Model.Compras)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @compra.NumeroCompra
                                </strong>
                            </td>


                            <td>
                                @compra.FechaCompra.ToString(
                                    "dd/MM/yyyy HH:mm"
                                )
                            </td>


                            <td>
                                @compra.Proveedor
                            </td>


                            <td>
                                @compra.Usuario
                            </td>


                            <td>
                                ₡@compra.Subtotal.ToString("N2")
                            </td>


                            <td>
                                ₡@compra.Impuesto.ToString("N2")
                            </td>


                            <td>
                                <strong>
                                    ₡@compra.Total.ToString("N2")
                                </strong>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="empty-state">

            <i class="bi bi-bag"></i>

            <strong class="d-block mb-1">
                No existen compras
            </strong>

            <span>
                No se encontraron compras en el período seleccionado.
            </span>

        </div>
    }

</div>
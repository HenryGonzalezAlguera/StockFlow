@using System.Text.Json
@model StockFlowWEB.Models.ViewModels.VentaFormViewModel

@{
    ViewData["Title"] = "Nueva venta";

    var productosJson =
        JsonSerializer.Serialize(
            Model.Productos.Select(
                x => new
                {
                    idProducto = x.IdProducto,
                    codigo = x.Codigo,
                    nombre = x.Nombre,
                    precioVenta = x.PrecioVenta,
                    stockActual = x.StockActual
                }
            )
        );

    var detallesJson =
        JsonSerializer.Serialize(
            Model.Detalles.Select(
                x => new
                {
                    idProducto = x.IdProducto,
                    cantidad = x.Cantidad
                }
            )
        );
}


<div class="page-header">

    <div>

        <h1>
            Nueva venta
        </h1>

        <p>
            Registra una salida de productos del inventario.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>

        Volver

    </a>

</div>


@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-danger">

        <i class="bi bi-exclamation-circle me-2"></i>

        @ViewBag.Mensaje

    </div>
}


<div asp-validation-summary="ModelOnly"
     class="alert alert-danger">
</div>


<form asp-action="Registrar"
      method="post"
      id="formVenta">


    <!-- =====================================================
         INFORMACIÓN GENERAL
    ====================================================== -->

    <div class="content-card mb-4">

        <div class="content-card-header">

            <h5>
                Información de la venta
            </h5>

            <p>
                El cliente es opcional para ventas de mostrador.
            </p>

        </div>


        <div class="content-card-body">

            <div class="row g-4">


                <!-- CLIENTE -->

                <div class="col-md-8">

                    <label asp-for="IdCliente"
                           class="form-label">

                        Cliente

                    </label>


                    <select asp-for="IdCliente"
                            class="form-select">

                        <option value="">
                            Cliente Ocasional
                        </option>


                        @foreach (var cliente in Model.Clientes)
                        {
                            <option value="@cliente.IdCliente">

                                @cliente.Nombre

                                @if (!string.IsNullOrWhiteSpace(
                                    cliente.Identificacion))
                                {
                                    <text>
                                        - @cliente.Identificacion
                                    </text>
                                }

                            </option>
                        }

                    </select>

                </div>


                <!-- IMPUESTO -->

                <div class="col-md-4">

                    <label asp-for="PorcentajeImpuesto"
                           class="form-label">

                        Impuesto

                    </label>


                    <div class="input-group">

                        <input asp-for="PorcentajeImpuesto"
                               type="number"
                               min="0"
                               max="100"
                               step="0.01"
                               class="form-control"
                               id="porcentajeImpuesto" />

                        <span class="input-group-text">
                            %
                        </span>

                    </div>

                </div>


            </div>

        </div>

    </div>



    <!-- =====================================================
         PRODUCTOS
    ====================================================== -->

    <div class="content-card mb-4">

        <div class="content-card-header">

            <h5>
                Productos de la venta
            </h5>

            <p>
                El precio se obtiene automáticamente del catálogo.
            </p>

        </div>


        <div class="content-card-body border-bottom">

            <div class="row g-3 align-items-end">


                <!-- PRODUCTO -->

                <div class="col-xl-7">

                    <label class="form-label">
                        Producto
                    </label>


                    <select id="productoSelector"
                            class="form-select">

                        <option value="">
                            Seleccione un producto
                        </option>


                        @foreach (var producto in Model.Productos)
                        {
                            if (producto.StockActual >= 1)
                            {
                                <option value="@producto.IdProducto">

                                    @producto.Codigo -
                                    @producto.Nombre -
                                    Stock: @producto.StockActual.ToString("0")

                                </option>
                            }
                            else
                            {
                                <option value="@producto.IdProducto"
                                        disabled>

                                    @producto.Codigo -
                                    @producto.Nombre -
                                    Sin stock

                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- CANTIDAD -->

                <div class="col-xl-3 col-md-6">

                    <label class="form-label">
                        Cantidad
                    </label>


                    <input type="number"
                           id="cantidadNueva"
                           class="form-control"
                           min="1"
                           step="1"
                           value="1" />

                </div>


                <!-- AGREGAR -->

                <div class="col-xl-2 col-md-6">

                    <button type="button"
                            class="btn btn-primary w-100"
                            id="agregarProducto">

                        <i class="bi bi-plus-lg me-1"></i>

                        Agregar

                    </button>

                </div>


            </div>


            <!-- INFORMACIÓN DEL PRODUCTO -->

            <div id="productoInfo"
                 class="mt-3"
                 style="display:none;">

                <div class="d-flex gap-4 small">

                    <div>

                        <span class="text-muted">
                            Precio:
                        </span>

                        <strong id="precioProducto">
                        </strong>

                    </div>


                    <div>

                        <span class="text-muted">
                            Disponible:
                        </span>

                        <strong id="stockProducto">
                        </strong>

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
             TABLA DETALLE
        ================================================== -->

        <div class="table-responsive">

            <table class="table table-modern mb-0">

                <thead>

                    <tr>

                        <th>
                            Producto
                        </th>

                        <th>
                            Disponible
                        </th>

                        <th style="width:170px;">
                            Cantidad
                        </th>

                        <th>
                            Precio
                        </th>

                        <th>
                            Subtotal
                        </th>

                        <th style="width:70px;">
                        </th>

                    </tr>

                </thead>


                <tbody id="detalleVenta">
                </tbody>

            </table>

        </div>


        <div id="sinProductos"
             class="empty-state">

            <i class="bi bi-cart-plus"></i>

            <strong class="d-block mb-1">
                Todavía no has agregado productos
            </strong>

            <span>
                Selecciona productos para comenzar la venta.
            </span>

        </div>

    </div>



    <!-- =====================================================
         RESUMEN
    ====================================================== -->

    <div class="row justify-content-end">

        <div class="col-xl-5 col-lg-6">

            <div class="content-card">

                <div class="content-card-header">

                    <h5>
                        Resumen de la venta
                    </h5>

                </div>


                <div class="content-card-body">


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <strong id="subtotalTexto">
                            ₡0.00
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Impuesto
                        </span>

                        <strong id="impuestoTexto">
                            ₡0.00
                        </strong>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between align-items-center">

                        <strong>
                            Total
                        </strong>


                        <strong class="fs-4"
                                id="totalTexto">

                            ₡0.00

                        </strong>

                    </div>


                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         BOTONES
    ====================================================== -->

    <div class="d-flex justify-content-end gap-2 mt-4">

        <a asp-action="Index"
           class="btn btn-light">

            Cancelar

        </a>


        <button type="submit"
                class="btn btn-primary btn-lg"
                id="btnRegistrarVenta">

            <i class="bi bi-check-circle me-1"
               id="iconoRegistrarVenta"></i>

            <span id="textoRegistrarVenta">
                Registrar venta
            </span>

        </button>

    </div>


</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        const productos =
                    @Html.Raw(productosJson);


        let detalles =
                    @Html.Raw(detallesJson);


        const formVenta =
            document.getElementById(
                "formVenta"
            );


        const selector =
            document.getElementById(
                "productoSelector"
            );


        const cantidadNueva =
            document.getElementById(
                "cantidadNueva"
            );


        const agregarProducto =
            document.getElementById(
                "agregarProducto"
            );


        const tabla =
            document.getElementById(
                "detalleVenta"
            );


        const sinProductos =
            document.getElementById(
                "sinProductos"
            );


        const porcentajeImpuesto =
            document.getElementById(
                "porcentajeImpuesto"
            );


        const productoInfo =
            document.getElementById(
                "productoInfo"
            );


        const precioProducto =
            document.getElementById(
                "precioProducto"
            );


        const stockProducto =
            document.getElementById(
                "stockProducto"
            );


        const subtotalTexto =
            document.getElementById(
                "subtotalTexto"
            );


        const impuestoTexto =
            document.getElementById(
                "impuestoTexto"
            );


        const totalTexto =
            document.getElementById(
                "totalTexto"
            );


        const btnRegistrarVenta =
            document.getElementById(
                "btnRegistrarVenta"
            );


        const iconoRegistrarVenta =
            document.getElementById(
                "iconoRegistrarVenta"
            );


        const textoRegistrarVenta =
            document.getElementById(
                "textoRegistrarVenta"
            );


        let envioEnCurso =
            false;



        // =========================================================
        // FORMATO MONEDA
        // =========================================================

        const formatoCRC =
            new Intl.NumberFormat(
                "es-CR",
                {
                    style:
                        "currency",

                    currency:
                        "CRC"
                }
            );



        // =========================================================
        // FORMATO CANTIDADES
        //
        // StockFlow maneja visualmente las existencias
        // como unidades enteras.
        //
        // 98.000 -> 98
        // 3.000  -> 3
        // =========================================================

        function formatearCantidad(
            valor) {
            const numero =
                Number(
                    valor
                );


            if (!Number.isFinite(
                numero)) {
                return "0";
            }


            return String(
                Math.trunc(
                    numero
                )
            );
        }



        // =========================================================
        // OBTENER PRODUCTO
        // =========================================================

        function obtenerProducto(
            idProducto) {
            return productos.find(
                x =>
                    Number(
                        x.idProducto
                    )
                    ===
                    Number(
                        idProducto
                    )
            );
        }



        // =========================================================
        // VALIDAR CANTIDAD ENTERA
        // =========================================================

        function cantidadEnteraValida(
            cantidad) {
            return Number.isFinite(
                cantidad
            )
                &&
                Number.isInteger(
                    cantidad
                )
                &&
                cantidad >= 1;
        }



        // =========================================================
        // CAMBIO DE PRODUCTO
        // =========================================================

        selector.addEventListener(
            "change",
            function() {
                const producto =
                    obtenerProducto(
                        this.value
                    );


                if (!producto) {
                    productoInfo.style.display =
                        "none";


                    precioProducto.textContent =
                        "";


                    stockProducto.textContent =
                        "";


                    return;
                }


                precioProducto.textContent =
                    formatoCRC.format(
                        producto.precioVenta
                    );


                stockProducto.textContent =
                    formatearCantidad(
                        producto.stockActual
                    );


                productoInfo.style.display =
                    "block";
            }
        );



        // =========================================================
        // AGREGAR PRODUCTO
        // =========================================================

        agregarProducto.addEventListener(
            "click",
            function() {
                const idProducto =
                    Number(
                        selector.value
                    );


                const cantidad =
                    Number(
                        cantidadNueva.value
                    );


                const producto =
                    obtenerProducto(
                        idProducto
                    );


                if (!producto) {
                    alert(
                        "Seleccione un producto."
                    );

                    selector.focus();

                    return;
                }


                if (!cantidadEnteraValida(
                    cantidad)) {
                    alert(
                        "La cantidad debe ser un número entero mayor a cero."
                    );

                    cantidadNueva.focus();

                    return;
                }


                if (
                    cantidad
                    >
                    Number(
                        producto.stockActual
                    )
                ) {
                    alert(
                        "No existe stock suficiente. Disponible: "
                        +
                        formatearCantidad(
                            producto.stockActual
                        )
                    );

                    cantidadNueva.focus();

                    return;
                }


                const existente =
                    detalles.some(
                        x =>
                            Number(
                                x.idProducto
                            )
                            ===
                            idProducto
                    );


                if (existente) {
                    alert(
                        "Este producto ya fue agregado."
                    );

                    return;
                }


                detalles.push(
                    {
                        idProducto:
                            idProducto,

                        cantidad:
                            cantidad
                    }
                );


                selector.value =
                    "";


                cantidadNueva.value =
                    "1";


                productoInfo.style.display =
                    "none";


                precioProducto.textContent =
                    "";


                stockProducto.textContent =
                    "";


                renderizar();
            }
        );



        // =========================================================
        // ELIMINAR PRODUCTO
        // =========================================================

        function eliminarProducto(
            indice) {
            if (
                indice < 0
                ||
                indice >= detalles.length
            ) {
                return;
            }


            detalles.splice(
                indice,
                1
            );


            renderizar();
        }



        // =========================================================
        // CAMBIAR CANTIDAD
        // =========================================================

        function cambiarCantidad(
            indice,
            valor) {
            const cantidad =
                Number(
                    valor
                );


            const detalle =
                detalles[indice];


            if (!detalle) {
                return;
            }


            const producto =
                obtenerProducto(
                    detalle.idProducto
                );


            if (!producto) {
                renderizar();

                return;
            }


            if (!cantidadEnteraValida(
                cantidad)) {
                alert(
                    "La cantidad debe ser un número entero mayor a cero."
                );


                renderizar();

                return;
            }


            if (
                cantidad
                >
                Number(
                    producto.stockActual
                )
            ) {
                alert(
                    "Stock insuficiente. Disponible: "
                    +
                    formatearCantidad(
                        producto.stockActual
                    )
                );


                renderizar();

                return;
            }


            detalles[indice].cantidad =
                cantidad;


            renderizar();
        }



        // =========================================================
        // CELDA PRODUCTO
        // =========================================================

        function crearCeldaProducto(
            producto,
            detalle,
            indice) {
            const celda =
                document.createElement(
                    "td"
                );


            const nombre =
                document.createElement(
                    "strong"
                );


            nombre.textContent =
                producto.nombre ?? "";


            const codigo =
                document.createElement(
                    "div"
                );


            codigo.className =
                "small text-muted";


            codigo.textContent =
                producto.codigo ?? "";


            const idInput =
                document.createElement(
                    "input"
                );


            idInput.type =
                "hidden";


            idInput.name =
                `Detalles[${indice}].IdProducto`;


            idInput.value =
                String(
                    detalle.idProducto
                );


            celda.appendChild(
                nombre
            );


            celda.appendChild(
                codigo
            );


            celda.appendChild(
                idInput
            );


            return celda;
        }



        // =========================================================
        // CELDA STOCK
        // =========================================================

        function crearCeldaStock(
            producto) {
            const celda =
                document.createElement(
                    "td"
                );


            const badge =
                document.createElement(
                    "span"
                );


            badge.className =
                "badge bg-light text-dark";


            badge.textContent =
                formatearCantidad(
                    producto.stockActual
                );


            celda.appendChild(
                badge
            );


            return celda;
        }



        // =========================================================
        // CELDA CANTIDAD
        // =========================================================

        function crearCeldaCantidad(
            detalle,
            producto,
            indice) {
            const celda =
                document.createElement(
                    "td"
                );


            const input =
                document.createElement(
                    "input"
                );


            input.type =
                "number";


            input.className =
                "form-control form-control-sm";


            input.name =
                `Detalles[${indice}].Cantidad`;


            input.min =
                "1";


            input.max =
                String(
                    Math.floor(
                        Number(
                            producto.stockActual
                        )
                    )
                );


            input.step =
                "1";


            input.value =
                String(
                    Math.trunc(
                        Number(
                            detalle.cantidad
                        )
                    )
                );


            input.addEventListener(
                "change",
                function() {
                    cambiarCantidad(
                        indice,
                        this.value
                    );
                }
            );


            celda.appendChild(
                input
            );


            return celda;
        }



        // =========================================================
        // CELDA PRECIO
        // =========================================================

        function crearCeldaPrecio(
            producto) {
            const celda =
                document.createElement(
                    "td"
                );


            celda.textContent =
                formatoCRC.format(
                    producto.precioVenta
                );


            return celda;
        }



        // =========================================================
        // CELDA SUBTOTAL
        // =========================================================

        function crearCeldaSubtotal(
            subtotal) {
            const celda =
                document.createElement(
                    "td"
                );


            const texto =
                document.createElement(
                    "strong"
                );


            texto.textContent =
                formatoCRC.format(
                    subtotal
                );


            celda.appendChild(
                texto
            );


            return celda;
        }



        // =========================================================
        // CELDA ELIMINAR
        // =========================================================

        function crearCeldaEliminar(
            indice) {
            const celda =
                document.createElement(
                    "td"
                );


            celda.className =
                "text-end";


            const boton =
                document.createElement(
                    "button"
                );


            boton.type =
                "button";


            boton.className =
                "btn btn-sm btn-outline-danger";


            boton.title =
                "Eliminar producto";


            boton.setAttribute(
                "aria-label",
                "Eliminar producto"
            );


            const icono =
                document.createElement(
                    "i"
                );


            icono.className =
                "bi bi-trash";


            boton.appendChild(
                icono
            );


            boton.addEventListener(
                "click",
                function() {
                    eliminarProducto(
                        indice
                    );
                }
            );


            celda.appendChild(
                boton
            );


            return celda;
        }



        // =========================================================
        // RENDERIZAR TABLA
        // =========================================================

        function renderizar() {
            tabla.replaceChildren();


            sinProductos.style.display =
                detalles.length === 0
                    ? "block"
                    : "none";


            detalles.forEach(
                (
                    detalle,
                    indice
                ) => {
                    const producto =
                        obtenerProducto(
                            detalle.idProducto
                        );


                    if (!producto) {
                        return;
                    }


                    const subtotal =
                        Number(
                            detalle.cantidad
                        )
                        *
                        Number(
                            producto.precioVenta
                        );


                    const fila =
                        document.createElement(
                            "tr"
                        );


                    fila.appendChild(
                        crearCeldaProducto(
                            producto,
                            detalle,
                            indice
                        )
                    );


                    fila.appendChild(
                        crearCeldaStock(
                            producto
                        )
                    );


                    fila.appendChild(
                        crearCeldaCantidad(
                            detalle,
                            producto,
                            indice
                        )
                    );


                    fila.appendChild(
                        crearCeldaPrecio(
                            producto
                        )
                    );


                    fila.appendChild(
                        crearCeldaSubtotal(
                            subtotal
                        )
                    );


                    fila.appendChild(
                        crearCeldaEliminar(
                            indice
                        )
                    );


                    tabla.appendChild(
                        fila
                    );
                }
            );


            actualizarTotales();
        }



        // =========================================================
        // ACTUALIZAR TOTALES
        // =========================================================

        function actualizarTotales() {
            const subtotal =
                detalles.reduce(
                    (
                        acumulado,
                        detalle
                    ) => {
                        const producto =
                            obtenerProducto(
                                detalle.idProducto
                            );


                        if (!producto) {
                            return acumulado;
                        }


                        return acumulado
                            +
                            (
                                Number(
                                    detalle.cantidad
                                )
                                *
                                Number(
                                    producto.precioVenta
                                )
                            );
                    },
                    0
                );


            const porcentaje =
                Number(
                    porcentajeImpuesto.value
                );


            const porcentajeValido =
                Number.isFinite(
                    porcentaje
                )
                    ? porcentaje
                    : 0;


            const impuesto =
                subtotal
                *
                (
                    porcentajeValido
                    /
                    100
                );


            const total =
                subtotal
                +
                impuesto;


            subtotalTexto.textContent =
                formatoCRC.format(
                    subtotal
                );


            impuestoTexto.textContent =
                formatoCRC.format(
                    impuesto
                );


            totalTexto.textContent =
                formatoCRC.format(
                    total
                );
        }



        porcentajeImpuesto.addEventListener(
            "input",
            actualizarTotales
        );



        // =========================================================
        // VALIDAR TODOS LOS DETALLES ANTES DEL SUBMIT
        // =========================================================

        function detallesValidos() {
            if (detalles.length === 0) {
                alert(
                    "Debe agregar al menos un producto."
                );

                return false;
            }


            for (const detalle of detalles) {
                const producto =
                    obtenerProducto(
                        detalle.idProducto
                    );


                if (!producto) {
                    alert(
                        "Uno de los productos seleccionados ya no está disponible."
                    );

                    return false;
                }


                const cantidad =
                    Number(
                        detalle.cantidad
                    );


                if (!cantidadEnteraValida(
                    cantidad)) {
                    alert(
                        "Todas las cantidades deben ser números enteros mayores a cero."
                    );

                    return false;
                }


                if (
                    cantidad
                    >
                    Number(
                        producto.stockActual
                    )
                ) {
                    alert(
                        "Uno de los productos supera el stock disponible."
                    );

                    return false;
                }
            }


            return true;
        }



        // =========================================================
        // BLOQUEAR FORMULARIO
        // EVITA DOBLE REGISTRO
        // =========================================================

        function bloquearFormulario() {
            envioEnCurso =
                true;


            btnRegistrarVenta.disabled =
                true;


            agregarProducto.disabled =
                true;


            iconoRegistrarVenta.className =
                "bi bi-hourglass-split me-1";


            textoRegistrarVenta.textContent =
                "Registrando...";
        }



        // =========================================================
        // SUBMIT
        // =========================================================

        formVenta.addEventListener(
            "submit",
            function(event) {
                if (envioEnCurso) {
                    event.preventDefault();

                    return;
                }


                if (!detallesValidos()) {
                    event.preventDefault();

                    return;
                }


                if (!formVenta.checkValidity()) {
                    event.preventDefault();

                    formVenta.reportValidity();

                    return;
                }


                if (
                    typeof window.jQuery
                    !==
                    "undefined"
                    &&
                    typeof window.jQuery.fn.valid
                    ===
                    "function"
                    &&
                    !window.jQuery(
                        formVenta
                    ).valid()
                ) {
                    event.preventDefault();

                    return;
                }


                bloquearFormulario();
            }
        );


        renderizar();

    </script>
}